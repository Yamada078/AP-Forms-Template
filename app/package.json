{
  "name": "applus-forms",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "check:build": "wrangler deploy --dry-run --outdir dist",
    "key:local": "node scripts/create-local-key.mjs",
    "db:generate": "node scripts/generate-bootstrap-schema.mjs",
    "db:setup:local": "wrangler d1 execute DB --local --file database/bootstrap.sql",
    "db:setup:remote": "wrangler d1 execute DB --remote --file database/bootstrap.sql"
  },
  "devDependencies": { "wrangler": "4.147.0" }
}
